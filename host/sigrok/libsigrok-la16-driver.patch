new file mode 100644
index 0000000..9b1e995
--- /dev/null
+++ b/src/hardware/la16/api.c
@@ -0,0 +1,323 @@
+/*
+ * This file is part of the libsigrok project.
+ *
+ * Copyright (C) 2026 Ahmad Panogari
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+/*
+ * la16: FPGA logic analyzer with its own framed serial protocol
+ * ( status while capturing, oldest-first upload with the trigger position,
+ * level and edge triggers ). Reference implementation: Antminer S9 control
+ * board ( Zynq XC7Z010 ), 16 channels at up to 200 MS/s.
+ */
+
+#include <config.h>
+#include "protocol.h"
+
+#define SERIALCOMM "921600/8n1"
+
+static const uint32_t scanopts[] = {
+	SR_CONF_CONN,
+	SR_CONF_SERIALCOMM,
+};
+
+static const uint32_t drvopts[] = {
+	SR_CONF_LOGIC_ANALYZER,
+};
+
+static const uint32_t devopts[] = {
+	SR_CONF_CONN | SR_CONF_GET,
+	SR_CONF_LIMIT_SAMPLES | SR_CONF_GET | SR_CONF_SET | SR_CONF_LIST,
+	SR_CONF_SAMPLERATE | SR_CONF_GET | SR_CONF_SET | SR_CONF_LIST,
+	SR_CONF_TRIGGER_MATCH | SR_CONF_LIST,
+	SR_CONF_CAPTURE_RATIO | SR_CONF_GET | SR_CONF_SET,
+};
+
+static const int32_t trigger_matches[] = {
+	SR_TRIGGER_ZERO,
+	SR_TRIGGER_ONE,
+	SR_TRIGGER_RISING,
+	SR_TRIGGER_FALLING,
+	SR_TRIGGER_EDGE,
+};
+
+static const char *channel_names[LA16_NUM_CHANNELS] = {
+	"D0", "D1", "D2", "D3", "D4", "D5", "D6", "D7",
+	"D8", "D9", "D10", "D11", "D12", "D13", "D14", "D15",
+};
+
+/* Offered when base_rate / rate is an integer. */
+static const uint64_t samplerate_candidates[] = {
+	SR_MHZ(200), SR_MHZ(100), SR_MHZ(50), SR_MHZ(40), SR_MHZ(25),
+	SR_MHZ(20), SR_MHZ(10), SR_MHZ(8), SR_MHZ(5), SR_MHZ(4), SR_MHZ(2),
+	SR_MHZ(1), SR_KHZ(500), SR_KHZ(400), SR_KHZ(250), SR_KHZ(200),
+	SR_KHZ(100), SR_KHZ(50), SR_KHZ(40), SR_KHZ(25), SR_KHZ(20),
+	SR_KHZ(10), SR_KHZ(5), SR_KHZ(2), SR_KHZ(1),
+};
+
+static gboolean rate_ok(const struct dev_context *devc, uint64_t rate)
+{
+	return rate && rate <= devc->base_rate && devc->base_rate % rate == 0 &&
+		devc->base_rate / rate <= UINT32_MAX;
+}
+
+static GSList *scan(struct sr_dev_driver *di, GSList *options)
+{
+	struct sr_config *src;
+	struct sr_dev_inst *sdi;
+	struct sr_serial_dev_inst *serial;
+	struct dev_context *devc;
+	struct la16_rx rx;
+	struct la16_frame f;
+	const char *conn, *serialcomm, *s, *end;
+	const char *strings[3];
+	GSList *l;
+	unsigned int i;
+
+	conn = serialcomm = NULL;
+	for (l = options; l; l = l->next) {
+		src = l->data;
+		switch (src->key) {
+		case SR_CONF_CONN:
+			conn = g_variant_get_string(src->data, NULL);
+			break;
+		case SR_CONF_SERIALCOMM:
+			serialcomm = g_variant_get_string(src->data, NULL);
+			break;
+		}
+	}
+	if (!conn)
+		return NULL;
+	if (!serialcomm)
+		serialcomm = SERIALCOMM;
+
+	serial = sr_serial_dev_inst_new(conn, serialcomm);
+	sr_info("Probing %s.", conn);
+	if (serial_open(serial, SERIAL_RDWR) != SR_OK)
+		return NULL;
+
+	serial_flush(serial);
+	rx.len = 0;
+	/* ABORT first: a capture left running by someone else is stopped. */
+	if (la16_send(serial, LA16_CMD_ABORT, NULL, 0) != SR_OK ||
+			la16_send(serial, LA16_CMD_IDENT, NULL, 0) != SR_OK ||
+			la16_wait_frame(serial, &rx, LA16_RSP_IDENT, &f,
+				LA16_REPLY_TIMEOUT_MS) != SR_OK ||
+			f.len < 13) {
+		sr_dbg("No la16 IDENT reply.");
+		serial_close(serial);
+		return NULL;
+	}
+
+	devc = g_malloc0(sizeof(*devc));
+	devc->proto_version = f.payload[0];
+	devc->base_rate = RL32(&f.payload[2]);
+	devc->max_samples = RL32(&f.payload[6]);
+	devc->features = RL16(&f.payload[10]);
+
+	/* vendor \0 model \0 version \0 */
+	s = (const char *)&f.payload[12];
+	end = (const char *)&f.payload[f.len];
+	for (i = 0; i < 3; i++) {
+		strings[i] = (s < end && memchr(s, 0, end - s)) ? s : "";
+		s += strlen(strings[i]) + 1;
+	}
+
+	if (devc->proto_version != 1 || f.payload[1] != LA16_NUM_CHANNELS ||
+			!devc->base_rate || devc->max_samples < LA16_MIN_SAMPLES) {
+		sr_err("Unsupported la16 device ( protocol %u, %u channels ).",
+			devc->proto_version, f.payload[1]);
+		g_free(devc);
+		serial_close(serial);
+		return NULL;
+	}
+	sr_info("Found %s %s %s: base %" PRIu64 " Hz, %" PRIu64
+		" samples, features 0x%04x.", strings[0], strings[1], strings[2],
+		devc->base_rate, devc->max_samples, devc->features);
+
+	devc->cur_samplerate = devc->base_rate;
+	for (i = 0; i < ARRAY_SIZE(samplerate_candidates); i++) {
+		if (samplerate_candidates[i] == SR_MHZ(1) &&
+				rate_ok(devc, samplerate_candidates[i]))
+			devc->cur_samplerate = SR_MHZ(1);
+	}
+	devc->limit_samples = MIN(devc->max_samples, 65536);
+	devc->capture_ratio = 10;
+
+	sdi = g_malloc0(sizeof(*sdi));
+	sdi->status = SR_ST_INACTIVE;
+	sdi->vendor = g_strdup(strings[0]);
+	sdi->model = g_strdup(strings[1]);
+	sdi->version = g_strdup(strings[2]);
+	sdi->inst_type = SR_INST_SERIAL;
+	sdi->conn = serial;
+	sdi->connection_id = g_strdup(serial->port);
+	sdi->priv = devc;
+	for (i = 0; i < LA16_NUM_CHANNELS; i++)
+		sr_channel_new(sdi, i, SR_CHANNEL_LOGIC, TRUE, channel_names[i]);
+
+	serial_close(serial);
+
+	return std_scan_complete(di, g_slist_append(NULL, sdi));
+}
+
+static int config_get(uint32_t key, GVariant **data,
+	const struct sr_dev_inst *sdi, const struct sr_channel_group *cg)
+{
+	struct dev_context *devc;
+
+	(void)cg;
+
+	if (!sdi)
+		return SR_ERR_ARG;
+	devc = sdi->priv;
+
+	switch (key) {
+	case SR_CONF_CONN:
+		if (!sdi->conn || !sdi->connection_id)
+			return SR_ERR_NA;
+		*data = g_variant_new_string(sdi->connection_id);
+		break;
+	case SR_CONF_SAMPLERATE:
+		*data = g_variant_new_uint64(devc->cur_samplerate);
+		break;
+	case SR_CONF_LIMIT_SAMPLES:
+		*data = g_variant_new_uint64(devc->limit_samples);
+		break;
+	case SR_CONF_CAPTURE_RATIO:
+		*data = g_variant_new_uint64(devc->capture_ratio);
+		break;
+	default:
+		return SR_ERR_NA;
+	}
+
+	return SR_OK;
+}
+
+static int config_set(uint32_t key, GVariant *data,
+	const struct sr_dev_inst *sdi, const struct sr_channel_group *cg)
+{
+	struct dev_context *devc;
+	uint64_t v;
+
+	(void)cg;
+
+	devc = sdi->priv;
+
+	switch (key) {
+	case SR_CONF_SAMPLERATE:
+		v = g_variant_get_uint64(data);
+		if (!rate_ok(devc, v))
+			return SR_ERR_SAMPLERATE;
+		devc->cur_samplerate = v;
+		break;
+	case SR_CONF_LIMIT_SAMPLES:
+		v = g_variant_get_uint64(data);
+		if (v < LA16_MIN_SAMPLES || v > devc->max_samples)
+			return SR_ERR_ARG;
+		devc->limit_samples = v;
+		break;
+	case SR_CONF_CAPTURE_RATIO:
+		v = g_variant_get_uint64(data);
+		if (v > 100)
+			return SR_ERR_ARG;
+		devc->capture_ratio = v;
+		break;
+	default:
+		return SR_ERR_NA;
+	}
+
+	return SR_OK;
+}
+
+static int config_list(uint32_t key, GVariant **data,
+	const struct sr_dev_inst *sdi, const struct sr_channel_group *cg)
+{
+	struct dev_context *devc;
+	uint64_t rates[ARRAY_SIZE(samplerate_candidates)];
+	unsigned int i, n;
+
+	devc = sdi ? sdi->priv : NULL;
+
+	switch (key) {
+	case SR_CONF_SCAN_OPTIONS:
+	case SR_CONF_DEVICE_OPTIONS:
+		return STD_CONFIG_LIST(key, data, sdi, cg, scanopts, drvopts,
+			devopts);
+	case SR_CONF_SAMPLERATE:
+		if (!devc)
+			return SR_ERR_ARG;
+		/* Ascending, as frontends expect. */
+		n = 0;
+		for (i = ARRAY_SIZE(samplerate_candidates); i > 0; i--) {
+			if (rate_ok(devc, samplerate_candidates[i - 1]))
+				rates[n++] = samplerate_candidates[i - 1];
+		}
+		*data = std_gvar_samplerates(rates, n);
+		break;
+	case SR_CONF_LIMIT_SAMPLES:
+		if (!devc)
+			return SR_ERR_ARG;
+		*data = std_gvar_tuple_u64(LA16_MIN_SAMPLES, devc->max_samples);
+		break;
+	case SR_CONF_TRIGGER_MATCH:
+		*data = std_gvar_array_i32(ARRAY_AND_SIZE(trigger_matches));
+		break;
+	default:
+		return SR_ERR_NA;
+	}
+
+	return SR_OK;
+}
+
+static int dev_acquisition_start(const struct sr_dev_inst *sdi)
+{
+	int ret;
+
+	if ((ret = la16_start(sdi)) != SR_OK)
+		return ret;
+
+	std_session_send_df_header(sdi);
+
+	/* STATUS frames arrive every 50 ms while armed, so poll often. */
+	return serial_source_add(sdi->session, sdi->conn, G_IO_IN, 50,
+		la16_receive_data, (struct sr_dev_inst *)sdi);
+}
+
+static int dev_acquisition_stop(struct sr_dev_inst *sdi)
+{
+	return la16_abort(sdi);
+}
+
+static struct sr_dev_driver la16_driver_info = {
+	.name = "la16",
+	.longname = "la16 FPGA logic analyzer",
+	.api_version = 1,
+	.init = std_init,
+	.cleanup = std_cleanup,
+	.scan = scan,
+	.dev_list = std_dev_list,
+	.dev_clear = std_dev_clear,
+	.config_get = config_get,
+	.config_set = config_set,
+	.config_list = config_list,
+	.dev_open = std_serial_dev_open,
+	.dev_close = std_serial_dev_close,
+	.dev_acquisition_start = dev_acquisition_start,
+	.dev_acquisition_stop = dev_acquisition_stop,
+	.context = NULL,
+};
+SR_REGISTER_DEV_DRIVER(la16_driver_info);
