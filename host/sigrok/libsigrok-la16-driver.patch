+#ifndef LIBSIGROK_HARDWARE_LA16_PROTOCOL_H
+#define LIBSIGROK_HARDWARE_LA16_PROTOCOL_H
+
+#include <stdint.h>
+#include <glib.h>
+#include <libsigrok/libsigrok.h>
+#include "libsigrok-internal.h"
+
+#define LOG_PREFIX "la16"
+
+/*
+ * la16 protocol v1. Frames in both directions:
+ *   0xA5, type, len_lo, len_hi, payload[len], crc8
+ * crc8: polynomial 0x07, init 0, over type, len and payload.
+ */
+#define LA16_SYNC		0xA5
+#define LA16_MAX_PAYLOAD	1024
+#define LA16_MAX_FRAME		(LA16_MAX_PAYLOAD + 5)
+
+/* Host -> device */
+#define LA16_CMD_IDENT		0x01
+#define LA16_CMD_CONFIG		0x02
+#define LA16_CMD_ARM		0x03
+#define LA16_CMD_ABORT		0x04
+#define LA16_CMD_STATUS		0x05
+
+/* Device -> host */
+#define LA16_RSP_IDENT		0x81
+#define LA16_RSP_ACK		0x82
+#define LA16_RSP_STATUS		0x83
+#define LA16_RSP_DATA		0x84
+#define LA16_RSP_TRIGGER	0x85
+#define LA16_RSP_END		0x86
+#define LA16_RSP_ERROR		0x8F
+
+#define LA16_CONFIG_LEN		32
+#define LA16_END_ABORTED	(1 << 1)
+#define LA16_END_TIMEOUT	(1 << 2)
+#define LA16_FEATURE_EDGE	(1 << 0)
+
+#define LA16_NUM_CHANNELS	16
+#define LA16_MIN_SAMPLES	16
+#define LA16_REPLY_TIMEOUT_MS	500
+#define LA16_IDLE_TIMEOUT_MS	2000	/* STATUS comes every 50 ms */
+
+struct la16_rx {
+	uint8_t buf[2 * LA16_MAX_FRAME];
+	size_t len;
+};
+
+struct la16_frame {
+	uint8_t type;
+	uint16_t len;
+	uint8_t payload[LA16_MAX_PAYLOAD];
+};
+
+struct dev_context {
+	/* From IDENT */
+	uint8_t proto_version;
+	uint64_t base_rate;
+	uint64_t max_samples;
+	uint16_t features;
+
+	/* Settings */
+	uint64_t cur_samplerate;
+	uint64_t limit_samples;
+	uint64_t capture_ratio;
+
+	/* Acquisition */
+	struct la16_rx rx;
+	uint64_t samples_sent;
+	int64_t trigger_pos;		/* -1 = none ( yet ) */
+	gboolean trigger_sent;
+	uint8_t last_state;
+	int64_t last_rx_us;
+};
+
+SR_PRIV uint8_t la16_crc8(const uint8_t *data, size_t len);
+SR_PRIV int la16_send(struct sr_serial_dev_inst *serial, uint8_t type,
+	const uint8_t *payload, uint16_t len);
+SR_PRIV int la16_rx_fill(struct sr_serial_dev_inst *serial, struct la16_rx *rx);
+SR_PRIV gboolean la16_rx_frame(struct la16_rx *rx, struct la16_frame *f);
+SR_PRIV int la16_wait_frame(struct sr_serial_dev_inst *serial,
+	struct la16_rx *rx, uint8_t type, struct la16_frame *f, int timeout_ms);
+SR_PRIV int la16_start(const struct sr_dev_inst *sdi);
+SR_PRIV void la16_finish(const struct sr_dev_inst *sdi);
+SR_PRIV int la16_abort(const struct sr_dev_inst *sdi);
+SR_PRIV int la16_receive_data(int fd, int revents, void *cb_data);
+
+#endif
