+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include <config.h>
+#include "protocol.h"
+
+static const char *state_names[] = {
+	"idle", "pre-trigger fill", "waiting for trigger",
+	"post-trigger capture", "upload", "done",
+};
+
+SR_PRIV uint8_t la16_crc8(const uint8_t *data, size_t len)
+{
+	uint8_t c = 0;
+	size_t i;
+	int b;
+
+	for (i = 0; i < len; i++) {
+		c ^= data[i];
+		for (b = 0; b < 8; b++)
+			c = (c & 0x80) ? (uint8_t)((c << 1) ^ 0x07) : (uint8_t)(c << 1);
+	}
+
+	return c;
+}
+
+SR_PRIV int la16_send(struct sr_serial_dev_inst *serial, uint8_t type,
+	const uint8_t *payload, uint16_t len)
+{
+	uint8_t buf[LA16_MAX_FRAME];
+
+	if (len > LA16_MAX_PAYLOAD)
+		return SR_ERR_ARG;
+	buf[0] = LA16_SYNC;
+	buf[1] = type;
+	WL16(&buf[2], len);
+	if (len)
+		memcpy(&buf[4], payload, len);
+	buf[4 + len] = la16_crc8(&buf[1], 3 + len);
+
+	sr_dbg("Sending frame 0x%02x, %u payload bytes.", type, len);
+	if (serial_write_blocking(serial, buf, 5 + len,
+			serial_timeout(serial, 5 + len)) != 5 + len)
+		return SR_ERR;
+
+	return serial_drain(serial);
+}
+
+/* Append whatever the port has buffered. Empty reads are not an error. */
+SR_PRIV int la16_rx_fill(struct sr_serial_dev_inst *serial, struct la16_rx *rx)
+{
+	int n;
+
+	if (rx->len >= sizeof(rx->buf))
+		return 0;
+	n = serial_read_nonblocking(serial, &rx->buf[rx->len],
+		sizeof(rx->buf) - rx->len);
+	if (n < 0) {
+		sr_warn("Serial read failed (%d), retrying.", n);
+		return 0;
+	}
+	rx->len += n;
+
+	return n;
+}
+
+static void rx_drop(struct la16_rx *rx, size_t n)
+{
+	memmove(rx->buf, &rx->buf[n], rx->len - n);
+	rx->len -= n;
+}
+
+/* Take one complete frame with a valid CRC out of rx, resyncing on 0xA5. */
+SR_PRIV gboolean la16_rx_frame(struct la16_rx *rx, struct la16_frame *f)
+{
+	size_t len;
+
+	while (rx->len >= 5) {
+		if (rx->buf[0] != LA16_SYNC) {
+			rx_drop(rx, 1);
+			continue;
+		}
+		len = RL16(&rx->buf[2]);
+		if (len > LA16_MAX_PAYLOAD) {
+			rx_drop(rx, 1);
+			continue;
+		}
+		if (rx->len < len + 5)
+			return FALSE;
+		if (la16_crc8(&rx->buf[1], 3 + len) != rx->buf[4 + len]) {
+			sr_warn("Frame CRC error, resyncing.");
+			rx_drop(rx, 1);
+			continue;
+		}
+		f->type = rx->buf[1];
+		f->len = len;
+		memcpy(f->payload, &rx->buf[4], len);
+		rx_drop(rx, len + 5);
+		return TRUE;
+	}
+
+	return FALSE;
+}
+
+static void log_status(struct dev_context *devc, const struct la16_frame *f)
+{
+	uint8_t st;
+
+	if (f->len < 9)
+		return;
+	st = f->payload[0];
+	if (st != devc->last_state)
+		sr_info("Device: %s ( %u / %u samples ).",
+			st < ARRAY_SIZE(state_names) ? state_names[st] : "?",
+			RL32(&f->payload[1]), RL32(&f->payload[5]));
+	else
+		sr_dbg("Device: %s ( %u / %u samples ).",
+			st < ARRAY_SIZE(state_names) ? state_names[st] : "?",
+			RL32(&f->payload[1]), RL32(&f->payload[5]));
+	devc->last_state = st;
+}
+
+/*
+ * Blocking wait for a frame of the given type ( setup / scan / stop ).
+ * STATUS and other frames on the way are skipped, ERROR fails.
+ */
+SR_PRIV int la16_wait_frame(struct sr_serial_dev_inst *serial,
+	struct la16_rx *rx, uint8_t type, struct la16_frame *f, int timeout_ms)
+{
+	int64_t deadline;
+
+	deadline = g_get_monotonic_time() + (int64_t)timeout_ms * 1000;
+	while (g_get_monotonic_time() < deadline) {
+		while (la16_rx_frame(rx, f)) {
+			if (f->type == type)
+				return SR_OK;
+			if (f->type == LA16_RSP_ERROR && type != LA16_RSP_ERROR) {
+				sr_err("Device error %u.", f->len ? f->payload[0] : 0);
+				return SR_ERR;
+			}
+			sr_spew("Skipping frame 0x%02x while waiting for 0x%02x.",
+				f->type, type);
+		}
+		if (la16_rx_fill(serial, rx) == 0)
+			g_usleep(1000);
+	}
+
+	return SR_ERR_TIMEOUT;
+}
+
+static int convert_trigger(const struct sr_dev_inst *sdi, uint16_t *lvl_mask,
+	uint16_t *lvl_value, uint16_t *rise, uint16_t *fall)
+{
+	struct dev_context *devc;
+	struct sr_trigger *trigger;
+	struct sr_trigger_stage *stage;
+	struct sr_trigger_match *match;
+	const GSList *m;
+	uint16_t bit;
+
+	devc = sdi->priv;
+	*lvl_mask = *lvl_value = *rise = *fall = 0;
+	if (!(trigger = sr_session_trigger_get(sdi->session)))
+		return SR_OK;
+	if (g_slist_length(trigger->stages) > 1) {
+		sr_err("This device only supports 1 trigger stage.");
+		return SR_ERR_ARG;
+	}
+	stage = trigger->stages->data;
+	for (m = stage->matches; m; m = m->next) {
+		match = m->data;
+		if (!match->channel->enabled)
+			continue;
+		bit = 1 << match->channel->index;
+		switch (match->match) {
+		case SR_TRIGGER_ZERO:
+			*lvl_mask |= bit;
+			break;
+		case SR_TRIGGER_ONE:
+			*lvl_mask |= bit;
+			*lvl_value |= bit;
+			break;
+		case SR_TRIGGER_RISING:
+			*rise |= bit;
+			break;
+		case SR_TRIGGER_FALLING:
+			*fall |= bit;
+			break;
+		case SR_TRIGGER_EDGE:
+			*rise |= bit;
+			*fall |= bit;
+			break;
+		default:
+			sr_err("Unsupported trigger match %d.", match->match);
+			return SR_ERR_ARG;
+		}
+	}
+	if ((*rise | *fall) && !(devc->features & LA16_FEATURE_EDGE)) {
+		sr_err("This device has no edge triggers.");
+		return SR_ERR_ARG;
+	}
+
+	return SR_OK;
+}
+
+/* CONFIG + ARM, both acknowledged. */
+SR_PRIV int la16_start(const struct sr_dev_inst *sdi)
+{
+	struct dev_context *devc;
+	struct sr_serial_dev_inst *serial;
+	struct la16_frame f;
+	uint8_t cfg[LA16_CONFIG_LEN];
+	uint16_t lm, lv, tr, tf;
+	uint64_t pre, div;
+	int ret;
+
+	devc = sdi->priv;
+	serial = sdi->conn;
+
+	if ((ret = convert_trigger(sdi, &lm, &lv, &tr, &tf)) != SR_OK)
+		return ret;
+	if (devc->limit_samples < LA16_MIN_SAMPLES ||
+			devc->limit_samples > devc->max_samples) {
+		sr_err("Sample count must be %u .. %" PRIu64 ".",
+			LA16_MIN_SAMPLES, devc->max_samples);
+		return SR_ERR_ARG;
+	}
+	div = devc->base_rate / devc->cur_samplerate - 1;
+	pre = 0;
+	if (lm | tr | tf) {
+		pre = devc->limit_samples * devc->capture_ratio / 100;
+		if (pre >= devc->limit_samples)
+			pre = devc->limit_samples - 1;
+	}
+
+	memset(cfg, 0, sizeof(cfg));
+	cfg[0] = 0;				/* mode: buffer */
+	cfg[1] = 2;				/* upload format: auto */
+	WL16(&cfg[2], 0xFFFF);			/* channels */
+	WL32(&cfg[4], div);
+	WL32(&cfg[8], devc->limit_samples);
+	WL32(&cfg[12], pre);
+	WL16(&cfg[16], lm);
+	WL16(&cfg[18], lv);
+	WL16(&cfg[20], tr);
+	WL16(&cfg[22], tf);
+	WL32(&cfg[24], 0);			/* no trigger timeout */
+
+	sr_info("Capture: %" PRIu64 " samples at %" PRIu64 " Hz ( divider %"
+		PRIu64 " ), %" PRIu64 " pre-trigger, level %04x/%04x rise %04x"
+		" fall %04x.", devc->limit_samples, devc->cur_samplerate, div,
+		pre, lm, lv, tr, tf);
+
+	/* Stale bytes from an earlier capture are not part of this one. */
+	serial_flush(serial);
+	devc->rx.len = 0;
+
+	if ((ret = la16_send(serial, LA16_CMD_CONFIG, cfg, sizeof(cfg))) != SR_OK)
+		return ret;
+	if ((ret = la16_wait_frame(serial, &devc->rx, LA16_RSP_ACK, &f,
+			LA16_REPLY_TIMEOUT_MS)) != SR_OK) {
+		sr_err("CONFIG not acknowledged.");
+		return ret;
+	}
+	if ((ret = la16_send(serial, LA16_CMD_ARM, NULL, 0)) != SR_OK)
+		return ret;
+	if ((ret = la16_wait_frame(serial, &devc->rx, LA16_RSP_ACK, &f,
+			LA16_REPLY_TIMEOUT_MS)) != SR_OK) {
+		sr_err("ARM not acknowledged.");
+		return ret;
+	}
+
+	devc->samples_sent = 0;
+	devc->trigger_pos = -1;
+	devc->trigger_sent = FALSE;
+	devc->last_state = 0xFF;
+	devc->last_rx_us = g_get_monotonic_time();
+
+	return SR_OK;
+}
+
+SR_PRIV void la16_finish(const struct sr_dev_inst *sdi)
+{
+	serial_source_remove(sdi->session, sdi->conn);
+	std_session_send_df_end(sdi);
+}
+
+/* PulseView Stop: ABORT, then wait ( briefly ) for the END frame. */
+SR_PRIV int la16_abort(const struct sr_dev_inst *sdi)
+{
+	struct dev_context *devc;
+	struct la16_frame f;
+
+	devc = sdi->priv;
+	if (la16_send(sdi->conn, LA16_CMD_ABORT, NULL, 0) == SR_OK) {
+		if (la16_wait_frame(sdi->conn, &devc->rx, LA16_RSP_END, &f,
+				LA16_REPLY_TIMEOUT_MS) != SR_OK)
+			sr_warn("No END after ABORT.");
+	}
+	la16_finish(sdi);
+
+	return SR_OK;
+}
+
+static void send_logic(const struct sr_dev_inst *sdi, const uint8_t *data,
+	size_t samples)
+{
+	struct sr_datafeed_packet packet;
+	struct sr_datafeed_logic logic;
+
+	if (!samples)
+		return;
+	logic.length = samples * 2;
+	logic.unitsize = 2;
+	logic.data = (void *)data;
+	packet.type = SR_DF_LOGIC;
+	packet.payload = &logic;
+	sr_session_send(sdi, &packet);
+}
+
+/* DATA: samples go to the session at once, oldest first. */
+static void handle_data(const struct sr_dev_inst *sdi, const struct la16_frame *f)
+{
+	struct dev_context *devc;
+	const uint8_t *s;
+	uint64_t first, n, k;
+
+	devc = sdi->priv;
+	if (f->len < 4)
+		return;
+	first = RL32(f->payload);
+	n = (f->len - 4) / 2;
+	s = &f->payload[4];
+	if (first != devc->samples_sent)
+		sr_warn("DATA at sample %" PRIu64 ", expected %" PRIu64 ".",
+			first, devc->samples_sent);
+
+	if (devc->trigger_pos >= 0 && !devc->trigger_sent &&
+			(uint64_t)devc->trigger_pos < first + n) {
+		k = (uint64_t)devc->trigger_pos > first ?
+			(uint64_t)devc->trigger_pos - first : 0;
+		send_logic(sdi, s, k);
+		std_session_send_df_trigger(sdi);
+		devc->trigger_sent = TRUE;
+		send_logic(sdi, s + 2 * k, n - k);
+	} else {
+		send_logic(sdi, s, n);
+	}
+	devc->samples_sent = first + n;
+}
+
+SR_PRIV int la16_receive_data(int fd, int revents, void *cb_data)
+{
+	const struct sr_dev_inst *sdi;
+	struct dev_context *devc;
+	struct la16_frame f;
+	uint8_t flags;
+
+	(void)fd;
+	(void)revents;	/* Read on every call: Windows can signal G_IO_IN without data */
+
+	sdi = cb_data;
+	devc = sdi->priv;
+
+	if (la16_rx_fill(sdi->conn, &devc->rx) > 0)
+		devc->last_rx_us = g_get_monotonic_time();
+
+	while (la16_rx_frame(&devc->rx, &f)) {
+		switch (f.type) {
+		case LA16_RSP_STATUS:
+			log_status(devc, &f);
+			break;
+		case LA16_RSP_TRIGGER:
+			if (f.len >= 4)
+				devc->trigger_pos = RL32(f.payload);
+			sr_dbg("Trigger at sample %" PRIi64 ".", devc->trigger_pos);
+			break;
+		case LA16_RSP_DATA:
+			handle_data(sdi, &f);
+			break;
+		case LA16_RSP_END:
+			flags = f.len >= 5 ? f.payload[4] : 0;
+			sr_info("Capture done: %" PRIu64 " samples%s%s.",
+				devc->samples_sent,
+				(flags & LA16_END_ABORTED) ? ", aborted" : "",
+				(flags & LA16_END_TIMEOUT) ? ", trigger timeout" : "");
+			la16_finish(sdi);
+			return TRUE;
+		case LA16_RSP_ERROR:
+			sr_err("Device error %u.", f.len ? f.payload[0] : 0);
+			la16_finish(sdi);
+			return TRUE;
+		default:
+			sr_dbg("Ignoring frame 0x%02x.", f.type);
+			break;
+		}
+	}
+
+	if (g_get_monotonic_time() - devc->last_rx_us >
+			(int64_t)LA16_IDLE_TIMEOUT_MS * 1000) {
+		sr_err("Device stopped responding.");
+		la16_finish(sdi);
+	}
+
+	return TRUE;
+}
