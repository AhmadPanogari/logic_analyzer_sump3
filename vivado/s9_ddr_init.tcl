# -----------------------------------------------------------------------------
# Antminer S9 DDR init ( sourced by s9_ddr_test.tcl and, later, the DDR
# capture flow ). Register values from U-Boot,
# board/bitmain/antminer_s9/bitmain-antminer-s9/ps7_init_gpl.c
# ( SPDX-License-Identifier: GPL-2.0, (C) Copyright 2018 Michal Simek ),
# which boots this board: 32 bit DDR at 533 MHz, internal VREF, DDR I/O
# buffers, DCI and per byte lane training values tuned for the S9 PCB.
#
# Vivado's PS7 DDR presets ( build.tcl ) do not reproduce these values and
# fail on the board ( data bits shifted ), so the DDR controller is set up
# from this file instead of ps7_ddr_init_data_* in ps7_init.tcl.
#
# Call s9_ddr_init after the PLL and clock init of ps7_init.tcl. It sets
# the DDR I/O buffers + DCI, the DDR PLL ( 1066.7 MHz ) and DDR clocks
# ( 533 MHz ), then the DDR controller, and waits for normal operation.
# -----------------------------------------------------------------------------

proc s9_mw { a m v } {
  set r [mrd -force -value $a]
  mwr -force $a [expr { ( $r & ~$m ) | ( $v & $m ) }]
}
proc s9_mp { a m } {
  for { set i 0 } { $i < 1000 } { incr i } {
    if { ( [mrd -force -value $a] & $m ) != 0 } { return }
    after 1
  }
  error [format "timeout polling 0x%08X mask 0x%08X" $a $m]
}

proc s9_ddr_init {} {
  interp alias {} mw {} s9_mw
  interp alias {} mp {} s9_mp
